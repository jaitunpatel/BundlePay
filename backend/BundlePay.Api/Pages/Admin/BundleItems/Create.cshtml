@page
@model BundlePay.Api.Pages.Admin.BundleItems.CreateModel

<h2>Create Bundle Item</h2>

<form method="post" class="card">
    <div class="form-row">
        <label asp-for="BundleItem.BundleId"></label>
        <select asp-for="BundleItem.BundleId" asp-items="Model.Bundles"></select>
    </div>
    <div class="form-row">
        <label asp-for="BundleItem.ServiceId"></label>
        <select asp-for="BundleItem.ServiceId" asp-items="Model.Services"></select>
    </div>
    <div class="form-row">
        <label asp-for="BundleItem.Quantity"></label>
        <input asp-for="BundleItem.Quantity" />
    </div>
    <div class="form-row">
        <label asp-for="BundleItem.SortOrder"></label>
        <input asp-for="BundleItem.SortOrder" />
    </div>
    <button class="button" type="submit">Create</button>
    <a class="link" href="/Admin/BundleItems">Cancel</a>
</form>
