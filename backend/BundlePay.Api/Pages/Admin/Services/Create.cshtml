@page
@model BundlePay.Api.Pages.Admin.Services.CreateModel

<h2>Create Service</h2>

<form method="post" class="card">
    <div class="form-row">
        <label asp-for="Service.Name"></label>
        <input asp-for="Service.Name" />
    </div>
    <div class="form-row">
        <label asp-for="Service.Price"></label>
        <input asp-for="Service.Price" />
    </div>
    <div class="form-row">
        <label asp-for="Service.ServiceStatus"></label>
        <select asp-for="Service.ServiceStatus" asp-items="Model.Statuses"></select>
    </div>
    <button class="button" type="submit">Create</button>
    <a class="link" href="/Admin/Services">Cancel</a>
</form>
