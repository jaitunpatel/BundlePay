@page
@model BundlePay.Api.Pages.Admin.Services.IndexModel

<h2>Services</h2>
<p><a class="link" href="/Admin/Services/Create">Create new service</a></p>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Status</th>
            <th>Price</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Services)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.ServiceStatus</td>
            <td>@item.Price</td>
            <td>@item.CreatedAt.ToString("u")</td>
            <td class="actions">
                <a class="link" href="/Admin/Services/Details?id=@item.Id">Details</a>
                <a class="link" href="/Admin/Services/Edit?id=@item.Id">Edit</a>
                <a class="link" href="/Admin/Services/Delete?id=@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
