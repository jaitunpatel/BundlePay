@page
@model BundlePay.Api.Pages.Admin.Bundles.IndexModel

<h2>Bundles</h2>
<p><a class="link" href="/Admin/Bundles/Create">Create new bundle</a></p>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Price</th>
            <th>Image</th>
            <th>Active</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Bundles)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.BundleType</td>
            <td>@item.Price</td>
            <td>@(string.IsNullOrEmpty(item.ImageUrl) ? "No image" : $"<img src='{item.ImageUrl}' alt='Image' style='max-width: 100px;' />")</td>
            <td>@item.IsActive</td>
            <td>@item.CreatedAt.ToString("u")</td>
            <td class="actions">
                <a class="link" href="/Admin/Bundles/Details?id=@item.Id">Details</a>
                <a class="link" href="/Admin/Bundles/Edit?id=@item.Id">Edit</a>
                <a class="link" href="/Admin/Bundles/Delete?id=@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
