@page
@model BundlePay.Api.Pages.Admin.Bundles.DetailsModel

<h2>Bundle Details</h2>

<div class="card">
    <p><strong>Id:</strong> @Model.Bundle.Id</p>
    <p><strong>Name:</strong> @Model.Bundle.Name</p>
    <p><strong>Description:</strong> @Model.Bundle.Description</p>
    <p><strong>Type:</strong> @Model.Bundle.BundleType</p>
    <p><strong>Price:</strong> @Model.Bundle.Price</p>
    <p><strong>Image Url:</strong> @Model.Bundle.ImageUrl</p>
    <p><strong>Owner User Id:</strong> @Model.Bundle.OwnerUserId</p>
    <p><strong>Active:</strong> @Model.Bundle.IsActive</p>
    <p><strong>Created:</strong> @Model.Bundle.CreatedAt.ToString("u")</p>
    <p><strong>Updated:</strong> @Model.Bundle.UpdatedAt.ToString("u")</p>
</div>

<p>
    <a class="link" href="/Admin/Bundles/Edit?id=@Model.Bundle.Id">Edit</a>
    <a class="link" href="/Admin/Bundles">Back</a>
</p>
